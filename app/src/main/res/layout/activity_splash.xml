<?xml version="1.0" encoding="utf-8"?>
<!--
  启动页布局（Splash）。
  FrameLayout = 层叠布局，里面的内容一层层叠在一起，这里其实只有一个居中的竖排内容。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="32dp">

        <!--
          应用图标：和白底 logo 配套的圆角白色卡片，
          比直接放方形图标更柔和。id 留在卡片上，给动画用。
        -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/splashIcon"
            android:layout_width="120dp"
            android:layout_height="120dp"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="30dp"
            app:cardElevation="0dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/app_name"
                android:scaleType="fitCenter"
                android:src="@mipmap/ic_launcher_foreground" />

        </com.google.android.material.card.MaterialCardView>

        <!--
          fontFamily="cursive" 会用系统自带的手写体/书法体，
          letterSpacing 让字母之间稍微松一点，看起来更像英文书法。
        -->
        <com.example.habit.SplashTextAnimationView
            android:id="@+id/splashTagline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp" />

    </LinearLayout>

    <!-- 轻触屏幕继续：底部居中，整屏都能点 -->
    <TextView
        android:id="@+id/tvTapHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="64dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:letterSpacing="0.08"
        android:padding="12dp"
        android:text="@string/splash_tap_hint"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="15sp"
        android:visibility="gone" />

</FrameLayout>
